# GoalOS 配置文件模板 — 复制为 ~/.goalos/config/daemon.yaml 后填入真实值
#
# 此文件可安全提交到 Git — 不含任何真实密钥。
# 本地测试用: 复制为 daemon.test.yaml 填入真实 API Key（.gitignore 已保护）

daemon:
  port: 18920
  autonomy_level: autonomous     # observe|suggest|approve|autonomous
  idle_timeout: 5m               # 空闲超时后退出。默认 5m（config.go 同步键）
  shutdown_timeout: 5s           # 优雅关闭超时。默认 5s（config.go 同步键）

llm:
  provider: openai               # openai|anthropic|ollama
  model: glm-5.1                 # 模型名。OpenRouter 格式: openai/gpt-4o
  api_key_env: ANTHROPIC_API_KEY # API Key 环境变量名。默认 ANTHROPIC_API_KEY（config.go 同步键）
  api_key: ""                    # 填写 API Key。也支持环境变量 GOALOS_LLM_API_KEY
  base_url: ""                   # API 地址。空=默认端点
  max_tokens: 4096
  temperature: 0.3
  timeout: 300s
  plan_timeout: 600s             # Plan 阶段超时。默认 600s（config.go 同步键）

# 多模型验证（可选。用于代码审查时并行调用多个 LLM）
# multi_llm:
#   enabled: true
#   providers:
#     - name: primary
#       model: glm-5.1
#       api_key: ""
#       base_url: ""
#       allowed_for: [L0,L1,L2,L3,L4,L5]
#     - name: secondary
#       model: gpt-4o

# 模型粒度扩展（会议 #207 R-1424）：默认按档位路由（small/medium/strong）；
# 可显式覆盖为具体提供商 API+模型。粒度=全局/阶段/Flow/Agent 四级，后者覆盖前者。
# 非法覆盖（provider 不在配置清单/model 名非法）→ 配置校验拒绝。
# model_override:
#   global: { provider: "", model: "" }     # 全局覆盖（空=不覆盖）
#   stages: { planning: { provider: "", model: "" } }  # 阶段级
#   flows: { generic-v1: { provider: "", model: "" } } # Flow 级
#   agents: { GoalAgent: { provider: "", model: "" } }  # Agent 级
#       api_key: ""
#       base_url: https://api.openai.com/v1
#       allowed_for: [L0,L1,L2,L3]

policy:
  approval_timeout: 300         # 审批超时秒数
  token_budget: 1000000         # 单 Goal Token 上限
  token_warning: 0.8            # 预算警告阈值
  auto_fix_max: 3               # 自修正最大次数
  flow_degrade_threshold: 3     # Flow 降级触发次数
  goal_anchor_interval: 20      # GoalAnchor 间隔
  recovery_retry_max: 3         # Recovery 重试最大次数
  token_ttl: 300                # Capability Token TTL 秒（R-1359/R-1361——config.go 同步键）
  # 预留键（R-1386：随模块实现接线，05 B.8 为权威定义；落地前为文档预留键）
  # approval_max_extensions: 3  # wait_more 上限（R-1323）
  # guard.*: 见 05 B.8（R-1340：provider/model/timeout_ms/budget_tokens/scan_budget_bytes_per_session）
  # proxy.*: 见 05 B.8（R-1349 九键字面清单）
  # ipc.* / events.*: 见 05 B.8（R-1349/R-1389）

persona: concise                 # concise|warm|minimal
